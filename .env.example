# MySQL connection (set these to your local MySQL values)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cityflex_db

# Optional: Set a private administrator credential BEFORE the first server start.
# If ADMIN_PASSWORD is empty and no active admin exists, the server generates a random password
# and prints it once to the Terminal on first startup.
ADMIN_EMAIL=admin@cityflex.in
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Use-A-Unique-Password-At-Least-12-Chars

PORT=3000
NODE_ENV=development
